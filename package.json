{
  "name": "song-bottle",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "node server/index.js --dev",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.js",
    "test": "node --test tests/*.test.js",
    "test:browser": "node tests/browser.mjs",
    "format": "prettier --write src server shared tests *.json *.js *.html *.md",
    "share": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-share.ps1",
    "share:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stop-share.ps1"
  },
  "dependencies": {
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "prettier": "^3.9.6",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  }
}
